<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    tools:context=".MainActivity">

    <Space
        android:id="@+id/space"
        android:layout_width="61dp"
        android:layout_height="57dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/buttonAdelante"
        app:layout_constraintStart_toEndOf="@+id/buttonAtras"
        app:layout_constraintTop_toBottomOf="@+id/opcionesLayout" />

    <TextView
        android:id="@+id/textViewTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:text="Pregunta #"
        android:textAlignment="center"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/primary_dark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_margin="24dp"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/preguntaTexto"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="¿Cuál de estos es un mamífero?"
        android:textAlignment="center"
        android:textSize="22sp"
        android:textColor="@color/text_primary"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/textViewTitle" />

    <GridLayout
        android:id="@+id/opcionesLayout"
        android:layout_width="384dp"
        android:layout_height="296dp"
        android:layout_margin="24dp"
        android:alignmentMode="alignMargins"
        android:columnCount="2"
        android:rowCount="2"
        android:rowOrderPreserved="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.592"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/preguntaTexto"
        app:layout_constraintVertical_bias="0.254">

        <ImageButton
            android:id="@+id/buttonResp1"
            android:layout_width="0dp"
            android:layout_height="152dp"
            android:layout_row="0"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:background="@drawable/answer_bg"
            android:contentDescription="respuesta1"
            android:scaleType="centerCrop"
            tools:srcCompat="@tools:sample/avatars" />

        <ImageButton
            android:contentDescription="respuesta2"
            android:id="@+id/buttonResp2"
            android:layout_width="0dp"
            android:layout_height="152dp"
            android:layout_columnWeight="1"
            android:background="@drawable/answer_bg"
            android:scaleType="centerCrop"
            tools:srcCompat="@tools:sample/avatars" />

        <ImageButton
            android:id="@+id/buttonResp3"
            android:layout_width="0dp"
            android:layout_height="143dp"
            android:layout_columnWeight="1"
            android:background="@drawable/answer_bg"
            android:contentDescription="respuesta3"
            android:scaleType="centerCrop"
            tools:srcCompat="@tools:sample/avatars" />

        <ImageButton
            android:id="@+id/buttonResp4"
            android:contentDescription="respuesta4"
            android:layout_width="0dp"
            android:layout_height="143dp"
            android:layout_columnWeight="1"
            android:background="@drawable/answer_bg"
            android:scaleType="centerCrop"
            tools:srcCompat="@tools:sample/avatars" />
    </GridLayout>

    <Button
        android:id="@+id/buttonAtras"
        android:layout_width="135dp"
        android:layout_height="58dp"
        android:layout_marginStart="40dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="95dp"
        android:background="@drawable/button_bg"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:text="Atrás"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/opcionesLayout" />

    <Button
        android:id="@+id/buttonAdelante"
        android:layout_width="135dp"
        android:layout_height="58dp"
        android:layout_marginTop="19dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="97dp"
        android:background="@drawable/button_bg"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:text="Adelante"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/opcionesLayout" />

</androidx.constraintlayout.widget.ConstraintLayout>
