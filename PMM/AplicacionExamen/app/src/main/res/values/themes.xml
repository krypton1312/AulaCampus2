<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Основная тема приложения -->
    <style name="Theme.QuizApp" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Цвета интерфейса -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>

        <!-- Цвет фона -->
        <item name="android:windowBackground">@color/bg_light</item>

        <!-- Цвета текста -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Кнопки и элементы управления -->
        <item name="android:buttonStyle">@style/QuizButton</item>

        <!-- Шрифт -->
        <item name="android:fontFamily">sans-serif</item>

        <!-- Без ActionBar -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!-- Эффект нажатия -->
        <item name="android:colorControlHighlight">@color/accent</item>
    </style>

</resources>
